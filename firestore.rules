rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function pengelola() {
      return request.auth != null
        && request.auth.token.email in ['email-admin@gmail.com'];
    }

    // Konten publik: siapa pun boleh baca yang sudah terbit, hanya pengelola boleh tulis.
    match /berita/{doc}      { allow read: if true; allow write: if pengelola(); }
    match /gagasan/{doc}     { allow read: if true; allow write: if pengelola(); }
    match /pengabdian/{doc}  { allow read: if true; allow write: if pengelola(); }
    match /pengalaman/{doc}  { allow read: if true; allow write: if pengelola(); }
    match /event/{doc}       { allow read: if true; allow write: if pengelola(); }

    // Aspirasi warga: ditulis lewat API server (Admin SDK), dibaca hanya pengelola.
    match /aspirasi/{doc}    { allow read: if pengelola(); allow write: if false; }
  }
}
